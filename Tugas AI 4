// Global state
let filteredData = [...RAW_DATA];
let rankMode = 'rep'; // 'rep' or 'prod'
let charts = {};

const FILTER_CONFIGS = [
  { id: 'Year', key: 'yr', label: 'Years' },
  { id: 'Quarter', key: 'qtr', label: 'Quarters' },
  { id: 'Region', key: 'reg', label: 'Regions' },
  { id: 'Category', key: 'cat', label: 'Categories' },
  { id: 'Brand', key: 'brand', label: 'Brands' },
  { id: 'Rep', key: 'rep', label: 'Sales Reps' }
];

// Formatting Helpers
const fmtCurr = (val) => '$' + Math.round(val).toLocaleString('en-US');
const fmtCurrCompact = (val) => {
  if (Math.abs(val) >= 1e6) return '$' + (val / 1e6).toFixed(2) + 'M';
  if (Math.abs(val) >= 1e3) return '$' + (val / 1e3).toFixed(1) + 'K';
  return '$' + Math.round(val);
};
const fmtPct = (val) => val.toFixed(1) + '%';
const fmtInt = (val) => Math.round(val).toLocaleString('en-US');

// Initialize Multi-Select Checkboxes
function initFilters() {
  FILTER_CONFIGS.forEach(cfg => {
    const uniqueVals = [...new Set(RAW_DATA.map(d => d[cfg.key]))].sort((a, b) => a > b ? 1 : -1);
    const container = cfg.id === 'Rep' ? document.getElementById('repItemsList') : document.getElementById('menu' + cfg.id);
    let html = `
      <label class="multi-item" style="border-bottom:1px solid var(--border-color);font-weight:700;">
        <input type="checkbox" checked onchange="toggleSelectAll('${cfg.id}', this.checked)" id="all_${cfg.id}">
        <span>Select All (${uniqueVals.length})</span>
      </label>
    `;
    uniqueVals.forEach(v => {
      html += `
        <label class="multi-item item-${cfg.id}" data-label="${String(v).toLowerCase()}">
          <input type="checkbox" class="cb-${cfg.id}" value="${v}" checked onchange="onCheckboxChange('${cfg.id}')">
          <span>${v}${v === 2025 ? ' (Jan–Apr)' : ''}</span>
        </label>
      `;
    });
    container.innerHTML = html;
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.multi-dropdown')) {
      document.querySelectorAll('.multi-menu').forEach(m => m.classList.remove('open'));
    }
  });
}

function toggleDropdown(ddId) {
  const menu = document.querySelector(`#${ddId} .multi-menu`);
  const isOpen = menu.classList.contains('open');
  document.querySelectorAll('.multi-menu').forEach(m => m.classList.remove('open'));
  if (!isOpen) menu.classList.add('open');
}

function toggleSelectAll(id, checked) {
  document.querySelectorAll(`.cb-${id}`).forEach(cb => { cb.checked = checked; });
  updateDropdownButtonText(id);
  applyFilters();
}

function onCheckboxChange(id) {
  const allCbs = [...document.querySelectorAll(`.cb-${id}`)];
  const checkedCbs = allCbs.filter(c => c.checked);
  const allBox = document.getElementById(`all_${id}`);
  if (allBox) allBox.checked = checkedCbs.length === allCbs.length;
  updateDropdownButtonText(id);
  applyFilters();
}

function updateDropdownButtonText(id) {
  const cfg = FILTER_CONFIGS.find(c => c.id === id);
  const allCbs = [...document.querySelectorAll(`.cb-${id}`)];
  const checked = allCbs.filter(c => c.checked).map(c => c.value);
  const btn = document.querySelector(`#dd${id} .multi-select-btn`);
  if (checked.length === 0) {
    btn.textContent = `None Selected`;
  } else if (checked.length === allCbs.length) {
    btn.textContent = `All ${cfg.label} (${allCbs.length})`;
  } else if (checked.length <= 2) {
    btn.textContent = checked.join(', ');
  } else {
    btn.textContent = `${checked.length} of ${allCbs.length} ${cfg.label}`;
  }
}

function filterRepList() {
  const q = document.getElementById('searchRep').value.toLowerCase();
  document.querySelectorAll('.item-Rep').forEach(el => {
    el.style.display = el.dataset.label.includes(q) ? 'flex' : 'none';
  });
}

function getSelectedValues(id) {
  return new Set([...document.querySelectorAll(`.cb-${id}:checked`)].map(c => c.value));
}

function resetAllFilters() {
  document.getElementById('fStartDate').value = '2023-05-03';
  document.getElementById('fEndDate').value = '2025-04-28';
  document.getElementById('fStatus').value = 'ALL';
  document.getElementById('fReturn').value = 'ALL';
  document.getElementById('searchRep').value = '';
  filterRepList();
  FILTER_CONFIGS.forEach(cfg => {
    const allBox = document.getElementById(`all_${cfg.id}`);
    if (allBox) allBox.checked = true;
    document.querySelectorAll(`.cb-${cfg.id}`).forEach(cb => { cb.checked = true; });
    updateDropdownButtonText(cfg.id);
  });
  applyFilters();
}

function applyFilters() {
  const startDt = document.getElementById('fStartDate').value || '2023-05-03';
  const endDt = document.getElementById('fEndDate').value || '2025-04-28';
  const statusVal = document.getElementById('fStatus').value;
  const retVal = document.getElementById('fReturn').value;

  const selYear = getSelectedValues('Year');
  const selQtr = getSelectedValues('Quarter');
  const selReg = getSelectedValues('Region');
  const selCat = getSelectedValues('Category');
  const selBrand = getSelectedValues('Brand');
  const selRep = getSelectedValues('Rep');

  filteredData = RAW_DATA.filter(d => {
    if (d.dt < startDt || d.dt > endDt) return false;
    if (!selYear.has(String(d.yr))) return false;
    if (!selQtr.has(d.qtr)) return false;
    if (!selReg.has(d.reg)) return false;
    if (!selCat.has(d.cat)) return false;
    if (!selBrand.has(d.brand)) return false;
    if (!selRep.has(d.rep)) return false;
    if (statusVal !== 'ALL' && d.status !== statusVal) return false;
    if (retVal !== 'ALL' && d.ret !== retVal) return false;
    return true;
  });

  const pct = ((filteredData.length / RAW_DATA.length) * 100).toFixed(1);
  document.getElementById('activeFilterSummary').innerHTML =
    `Showing <strong>${filteredData.length}</strong> of ${RAW_DATA.length} orders (${pct}% of dataset)`;

  updateKPIs();
  updateCharts();
  updateInsights();
  renderTable();
}

// 1. UPDATE KPI CARDS
function updateKPIs() {
  const n = filteredData.length;
  const totalSales = filteredData.reduce((s, d) => s + d.sales, 0);
  const totalProfit = filteredData.reduce((s, d) => s + d.profit, 0);
  const overallMargin = totalSales > 0 ? (totalProfit / totalSales) * 100 : 0;
  const aov = n > 0 ? totalSales / n : 0;
  const retCount = filteredData.filter(d => d.ret === 'Yes').length;
  const retRate = n > 0 ? (retCount / n) * 100 : 0;
  const uniqCust = new Set(filteredData.map(d => d.cid)).size;
  const avgDisc = n > 0 ? filteredData.reduce((s, d) => s + d.disc, 0) / n : 0;

  document.getElementById('kpiSales').textContent = fmtCurr(totalSales);
  document.getElementById('kpiProfit').textContent = fmtCurr(totalProfit);
  document.getElementById('kpiMargin').textContent = fmtPct(overallMargin);
  document.getElementById('kpiOrders').textContent = fmtInt(n);
  document.getElementById('kpiAOV').textContent = fmtCurr(aov);
  document.getElementById('kpiReturn').textContent = fmtPct(retRate);
  document.getElementById('kpiCustomers').textContent = fmtInt(uniqCust);

  // Compute YoY 2024 vs 2023 inside current slice for directional indicators
  const d23 = filteredData.filter(d => d.yr === 2023);
  const d24 = filteredData.filter(d => d.yr === 2024);
  const d25 = filteredData.filter(d => d.yr === 2025);

  const s23 = d23.reduce((s, d) => s + d.sales, 0);
  const s24 = d24.reduce((s, d) => s + d.sales, 0);
  const p23 = d23.reduce((s, d) => s + d.profit, 0);
  const p24 = d24.reduce((s, d) => s + d.profit, 0);

  if (s23 > 0 && s24 > 0) {
    const salesYoY = ((s24 - s23) / s23) * 100;
    const profitYoY = ((p24 - p23) / p23) * 100;
    const m23 = (p23 / s23) * 100;
    const m24 = (p24 / s24) * 100;
    const mDiff = m24 - m23;

    document.getElementById('kpiSalesTrend').innerHTML =
      `<span class="${salesYoY >= 0 ? 'trend-up' : 'trend-down'}">${salesYoY >= 0 ? '▲' : '▼'} ${Math.abs(salesYoY).toFixed(1)}%</span> <span class="trend-neutral">FY24 vs FY23</span>`;
    document.getElementById('kpiProfitTrend').innerHTML =
      `<span class="${profitYoY >= 0 ? 'trend-up' : 'trend-down'}">${profitYoY >= 0 ? '▲' : '▼'} ${Math.abs(profitYoY).toFixed(1)}%</span> <span class="trend-neutral">FY24 vs FY23</span>`;
    document.getElementById('kpiMarginTrend').innerHTML =
      `<span class="${mDiff >= 0 ? 'trend-up' : 'trend-down'}">${mDiff >= 0 ? '▲' : '▼'} ${Math.abs(mDiff).toFixed(1)} pts</span> <span class="trend-neutral">FY24 vs FY23</span>`;
  } else {
    document.getElementById('kpiSalesTrend').innerHTML = `<span class="trend-neutral">Share of Total: ${((totalSales / 1936313.47) * 100).toFixed(1)}%</span>`;
    document.getElementById('kpiProfitTrend').innerHTML = `<span class="trend-neutral">Share of Total: ${((totalProfit / 593390.69) * 100).toFixed(1)}%</span>`;
    document.getElementById('kpiMarginTrend').innerHTML = `<span class="trend-neutral">Baseline: 30.6%</span>`;
  }

  document.getElementById('kpiOrdersTrend').innerHTML =
    `<span class="trend-neutral">FY23: ${d23.length} | FY24: ${d24.length} | YTD25: ${d25.length}*</span>`;
  document.getElementById('kpiAOVTrend').innerHTML =
    `<span class="trend-neutral">Baseline AOV: $3,873</span>`;
  document.getElementById('kpiReturnTrend').innerHTML =
    `<span class="${retRate > 30 ? 'trend-down' : 'trend-up'}">${retCount} returned orders</span> <span class="trend-warn">• High Risk</span>`;
  document.getElementById('kpiDiscountSub').innerHTML =
    `<span class="trend-neutral">Avg Discount: <strong>${avgDisc.toFixed(1)}%</strong></span>`;
}

// Helper for Pearson Correlation
function calcPearson(xs, ys) {
  const n = xs.length;
  if (n < 2) return 0;
  const meanX = xs.reduce((a, b) => a + b, 0) / n;
  const meanY = ys.reduce((a, b) => a + b, 0) / n;
  let num = 0, denX = 0, denY = 0;
  for (let i = 0; i < n; i++) {
    const dx = xs[i] - meanX;
    const dy = ys[i] - meanY;
    num += dx * dy;
    denX += dx * dx;
    denY += dy * dy;
  }
  return (denX > 0 && denY > 0) ? num / Math.sqrt(denX * denY) : 0;
}


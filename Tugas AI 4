<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Executive Sales & Profit Dashboard | FY 2023–2025</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-body: #f1f5f9;
    --bg-card: #ffffff;
    --bg-header: #0f172a;
    --bg-filter: #ffffff;
    --bg-subtle: #f8fafc;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --text-light: #94a3b8;
    --border-color: #e2e8f0;
    --accent-primary: #0f4c81;
    --accent-teal: #0d9488;
    --accent-blue: #2563eb;
    --accent-amber: #d97706;
    --accent-danger: #dc2626;
    --accent-success: #16a34a;
    --accent-purple: #7c3aed;
    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.07), 0 2px 4px -2px rgba(15, 23, 42, 0.05);
    --radius: 10px;
  }

  [data-theme="dark"] {
    --bg-body: #0b1120;
    --bg-card: #1e293b;
    --bg-header: #090d16;
    --bg-filter: #1e293b;
    --bg-subtle: #0f172a;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --text-light: #64748b;
    --border-color: #334155;
    --accent-primary: #38bdf8;
    --accent-teal: #2dd4bf;
    --accent-blue: #60a5fa;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-body);
    color: var(--text-main);
    line-height: 1.5;
    font-size: 14px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  /* TOP EXECUTIVE HEADER */
  .exec-header {
    background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
    color: #ffffff;
    padding: 18px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .exec-title-block h1 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .exec-subtitle {
    font-size: 12.5px;
    color: #cbd5e1;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .badge-partial {
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid #f59e0b;
    color: #fde68a;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .badge-dq {
    background: rgba(20, 184, 166, 0.2);
    border: 1px solid #14b8a6;
    color: #99f6e4;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-action {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 7px 13px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s ease;
  }

  .btn-action:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* STICKY FILTER BAR */
  .filter-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-filter);
    border-bottom: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    padding: 12px 28px;
  }

  .filter-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 130px;
    flex: 1;
  }

  .filter-group label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .filter-control, .multi-select-btn {
    height: 34px;
    padding: 0 10px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--text-main);
    font-size: 12.5px;
    font-family: inherit;
    width: 100%;
    outline: none;
    cursor: pointer;
  }

  .filter-control:focus, .multi-select-btn:focus {
    border-color: var(--accent-blue);
  }

  /* Custom Multi-Select Dropdown */
  .multi-dropdown {
    position: relative;
    width: 100%;
  }

  .multi-select-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .multi-select-btn::after {
    content: "▾";
    font-size: 11px;
    color: var(--text-muted);
    margin-left: 6px;
  }

  .multi-menu {
    display: none;
    position: absolute;
    top: 38px;
    left: 0;
    min-width: 190px;
    width: 100%;
    max-height: 240px;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: var(--shadow-md);
    padding: 6px;
    z-index: 200;
  }

  .multi-menu.open {
    display: block;
  }

  .multi-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 4px;
    font-size: 12.5px;
    cursor: pointer;
    user-select: none;
  }

  .multi-item:hover {
    background: var(--bg-subtle);
  }

  .multi-search {
    width: 100%;
    padding: 5px 8px;
    margin-bottom: 6px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 12px;
    background: var(--bg-subtle);
    color: var(--text-main);
  }

  .btn-reset {
    height: 34px;
    padding: 0 14px;
    background: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .btn-reset:hover {
    opacity: 0.9;
  }

  .filter-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--border-color);
    font-size: 12px;
    color: var(--text-muted);
  }

  /* MAIN CONTAINER */
  .dashboard-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px 28px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* KPI ROW (7 CARDS) */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 14px;
  }

  .kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--accent-primary);
    border-radius: var(--radius);
    padding: 14px 16px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .kpi-card.teal { border-top-color: var(--accent-teal); }
  .kpi-card.blue { border-top-color: var(--accent-blue); }
  .kpi-card.purple { border-top-color: var(--accent-purple); }
  .kpi-card.amber { border-top-color: var(--accent-amber); }
  .kpi-card.danger { border-top-color: var(--accent-danger); }
  .kpi-card.success { border-top-color: var(--accent-success); }

  .kpi-label {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }

  .kpi-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-main);
    margin: 6px 0;
    letter-spacing: -0.02em;
  }

  .kpi-trend {
    font-size: 11.5px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .trend-up { color: var(--accent-success); }
  .trend-down { color: var(--accent-danger); }
  .trend-warn { color: var(--accent-amber); }
  .trend-neutral { color: var(--text-muted); }

  /* CHARTS LAYOUT */
  .chart-grid-2 {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 18px;
  }

  .chart-grid-equal {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .chart-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 18px;
  }

  .card-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    gap: 8px;
  }

  .card-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-main);
  }

  .card-subtitle {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .card-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    white-space: nowrap;
  }

  .chart-box {
    position: relative;
    width: 100%;
    height: 290px;
  }

  .chart-box-sm {
    position: relative;
    width: 100%;
    height: 240px;
  }

  .toggle-group {
    display: inline-flex;
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
  }

  .toggle-btn {
    border: none;
    background: transparent;
    color: var(--text-muted);
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle-btn.active {
    background: var(--accent-blue);
    color: #ffffff;
  }

  /*OPERATIONAL MINI DONUTS*/
  .ops-donuts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    height: 240px;
  }

  .mini-donut-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: relative;
  }

  .mini-donut-title {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 6px;
    text-align: center;
  }

  .mini-donut-canvas {
    position: relative;
    width: 100%;
    height: 195px;
  }

  /* ACTIONABLE INSIGHTS PANEL */
  .insights-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 20px 22px;
    box-shadow: var(--shadow-sm);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 14px;
  }

  .insight-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-blue);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .insight-card.warn { border-left-color: var(--accent-danger); }
  .insight-card.amber { border-left-color: var(--accent-amber); }
  .insight-card.teal { border-left-color: var(--accent-teal); }
  .insight-card.purple { border-left-color: var(--accent-purple); }
  .insight-card.success { border-left-color: var(--accent-success); }

  .insight-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
  }

  .insight-badge {
    font-size: 10.5px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .insight-body {
    font-size: 12.5px;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .insight-action {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
    margin-top: auto;
    padding-top: 6px;
    border-top: 1px dashed var(--border-color);
  }

  /* COLLAPSIBLE DATA TABLE */
  .table-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 16px 20px;
    box-shadow: var(--shadow-sm);
  }

  .table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
    margin-bottom: 10px;
  }

  .table-wrap {
    overflow-x: auto;
    max-height: 420px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  table.exec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    text-align: left;
  }

  table.exec-table th {
    position: sticky;
    top: 0;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 11px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
  }

  table.exec-table td {
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
  }

  table.exec-table tr:hover td {
    background: var(--bg-subtle);
  }

  .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .pill-yes { background: rgba(220, 38, 38, 0.12); color: #dc2626; }
  .pill-no { background: rgba(22, 163, 74, 0.12); color: #16a34a; }

  @media (max-width: 1280px) {
    .kpi-grid { grid-template-columns: repeat(4, 1fr); }
    .chart-grid-2, .chart-grid-equal, .chart-grid-3, .insights-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media print {
    .filter-bar, .header-actions, .table-panel { display: none !important; }
    body { background: #fff; }
    .dashboard-container { padding: 0; }
  }
</style>
</head>
<body>

  <!-- TOP HEADER -->
  <header class="exec-header">
    <div class="exec-title-block">
      <h1>
        <span>📊 EXECUTIVE SALES & PROFITABILITY DASHBOARD</span>
      </h1>
      <div class="exec-subtitle">
        <span>Data Range: <strong>May 3, 2023 – Apr 28, 2025</strong> (500 Orders)</span>
        <span class="badge-partial">⚠️ Note: 2025 is Partial Year (Jan–Apr Only)</span>
        <span class="badge-dq" title="Gross Profit, Net Profit, and Profit columns are identical across all 500 records; consolidated into a single Profit KPI to prevent redundancy.">✓ Data Quality Verified: Unified Profit Metric</span>
      </div>
    </div>
    <div class="header-actions">
      <button class="btn-action" id="btnThemeToggle" onclick="toggleTheme()">🌙 Dark Mode</button>
      <button class="btn-action" onclick="exportFilteredCSV()">⬇️ Export CSV</button>
      <button class="btn-action" onclick="window.print()">🖨️ Print / PDF</button>
    </div>
  </header>

  <!-- STICKY INTERACTIVE FILTER / SLICER BAR -->
  <section class="filter-bar">
    <div class="filter-grid">
      <div class="filter-group" style="max-width:140px;">
        <label>Start Date</label>
        <input type="date" id="fStartDate" class="filter-control" value="2023-05-03" min="2023-05-03" max="2025-04-28" onchange="applyFilters()">
      </div>
      <div class="filter-group" style="max-width:140px;">
        <label>End Date</label>
        <input type="date" id="fEndDate" class="filter-control" value="2025-04-28" min="2023-05-03" max="2025-04-28" onchange="applyFilters()">
      </div>

      <!-- Year Multi-Select -->
      <div class="filter-group">
        <label>Year</label>
        <div class="multi-dropdown" id="ddYear">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddYear')">All Years (3)</button>
          <div class="multi-menu" id="menuYear"></div>
        </div>
      </div>

      <!-- Quarter Multi-Select -->
      <div class="filter-group">
        <label>Quarter</label>
        <div class="multi-dropdown" id="ddQuarter">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddQuarter')">All Quarters (4)</button>
          <div class="multi-menu" id="menuQuarter"></div>
        </div>
      </div>

      <!-- Region Multi-Select -->
      <div class="filter-group">
        <label>Region</label>
        <div class="multi-dropdown" id="ddRegion">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddRegion')">All Regions (4)</button>
          <div class="multi-menu" id="menuRegion"></div>
        </div>
      </div>

      <!-- Category Multi-Select -->
      <div class="filter-group">
        <label>Category</label>
        <div class="multi-dropdown" id="ddCategory">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddCategory')">All Categories (5)</button>
          <div class="multi-menu" id="menuCategory"></div>
        </div>
      </div>

      <!-- Brand Multi-Select -->
      <div class="filter-group">
        <label>Brand</label>
        <div class="multi-dropdown" id="ddBrand">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddBrand')">All Brands (3)</button>
          <div class="multi-menu" id="menuBrand"></div>
        </div>
      </div>

      <!-- Sales Person Searchable Multi-Select -->
      <div class="filter-group" style="min-width:165px;">
        <label>Sales Rep (Searchable)</label>
        <div class="multi-dropdown" id="ddRep">
          <button type="button" class="multi-select-btn" onclick="toggleDropdown('ddRep')">All Sales Reps (40)</button>
          <div class="multi-menu" id="menuRep">
            <input type="text" class="multi-search" id="searchRep" placeholder="Search 40 reps..." oninput="filterRepList()">
            <div id="repItemsList"></div>
          </div>
        </div>
      </div>

      <!-- Order Status -->
      <div class="filter-group" style="max-width:140px;">
        <label>Order Status</label>
        <select id="fStatus" class="filter-control" onchange="applyFilters()">
          <option value="ALL">All Statuses</option>
          <option value="Completed">Completed</option>
          <option value="Shipped">Shipped</option>
          <option value="Pending">Pending</option>
        </select>
      </div>

      <!-- Return Status -->
      <div class="filter-group" style="max-width:130px;">
        <label>Return Status</label>
        <select id="fReturn" class="filter-control" onchange="applyFilters()">
          <option value="ALL">All Orders</option>
          <option value="No">Retained (No)</option>
          <option value="Yes">Returned (Yes)</option>
        </select>
      </div>

      <button type="button" class="btn-reset" onclick="resetAllFilters()">↺ Reset Filters</button>
    </div>

    <div class="filter-status-bar">
      <div id="activeFilterSummary">Showing <strong>500</strong> of 500 orders (100.0% of dataset)</div>
      <div>2023 Full Year (May–Dec) • 2024 Full Year (Jan–Dec) • <strong>2025 YTD (Jan–Apr Partial)</strong></div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <main class="dashboard-container">

    <!-- 1. KPI HEADER ROW (7 CARDS) -->
    <section class="kpi-grid">
      <div class="kpi-card blue">
        <div class="kpi-label">Total Sales (Revenue)</div>
        <div class="kpi-value" id="kpiSales">$1,936,313</div>
        <div class="kpi-trend" id="kpiSalesTrend"></div>
      </div>
      <div class="kpi-card teal">
        <div class="kpi-label">Total Profit</div>
        <div class="kpi-value" id="kpiProfit">$593,391</div>
        <div class="kpi-trend" id="kpiProfitTrend"></div>
      </div>
      <div class="kpi-card success">
        <div class="kpi-label">Overall Profit Margin</div>
        <div class="kpi-value" id="kpiMargin">30.6%</div>
        <div class="kpi-trend" id="kpiMarginTrend"></div>
      </div>
      <div class="kpi-card purple">
        <div class="kpi-label">Total Orders</div>
        <div class="kpi-value" id="kpiOrders">500</div>
        <div class="kpi-trend" id="kpiOrdersTrend"></div>
      </div>
      <div class="kpi-card amber">
        <div class="kpi-label">Avg Order Value (AOV)</div>
        <div class="kpi-value" id="kpiAOV">$3,873</div>
        <div class="kpi-trend" id="kpiAOVTrend"></div>
      </div>
      <div class="kpi-card danger">
        <div class="kpi-label">Return Rate %</div>
        <div class="kpi-value" id="kpiReturn">49.6%</div>

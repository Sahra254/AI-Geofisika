      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 220 },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'top', labels: { boxWidth: 10, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: (ctx) => `${ctx.dataset.label}: ${fmtCurr(ctx.parsed.x)}`
          }
        }
      },
      scales: {
        x: { beginAtZero: true, grid: { color: gridColor }, ticks: { callback: (v) => fmtCurrCompact(v), font: { size: 10 } } },
        y: { grid: { display: false }, ticks: { font: { size: 11 } } }
      }
    }
  });

  // --- CHART 6: DISCOUNT % vs PROFIT MARGIN % SCATTER + REGRESSION LINE ---
  const discXs = filteredData.map(d => d.disc);
  const margYs = filteredData.map(d => d.margin);
  const rVal = calcPearson(discXs, margYs);
  document.getElementById('corrBadge').textContent = `Correlation r = ${rVal.toFixed(2)}`;

  // Compute simple linear regression y = a + b*x for trendline
  let slope = -0.82, intercept = 36.1;
  if (discXs.length >= 2) {
    const n = discXs.length;
    const mX = discXs.reduce((a, b) => a + b, 0) / n;
    const mY = margYs.reduce((a, b) => a + b, 0) / n;
    let num = 0, den = 0;
    for (let i = 0; i < n; i++) {
      num += (discXs[i] - mX) * (margYs[i] - mY);
      den += (discXs[i] - mX) ** 2;
    }
    if (den > 0) {
      slope = num / den;
      intercept = mY - slope * mX;
    }
  }

  const scatterPts = filteredData.map(d => ({ x: d.disc, y: d.margin, id: d.id, sales: d.sales, pname: d.pname }));

  if (charts.scatter) charts.scatter.destroy();
  charts.scatter = new Chart(document.getElementById('chartScatter'), {
    type: 'scatter',
    data: {
      datasets: [
        {
          type: 'line',
          label: 'OLS Trendline',
          data: [{ x: 0, y: +(intercept).toFixed(1) }, { x: 15, y: +(intercept + slope * 15).toFixed(1) }],
          borderColor: '#dc2626',
          borderWidth: 2.5,
          borderDash: [6, 4],
          pointRadius: 0,
          fill: false
        },
        {
          type: 'scatter',
          label: 'Orders (Discount % vs Margin %)',
          data: scatterPts,
          backgroundColor: 'rgba(37, 99, 235, 0.45)',
          borderColor: 'rgba(37, 99, 235, 0.85)',
          pointRadius: 4
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 220 },
      plugins: {
        legend: { position: 'top', labels: { boxWidth: 10, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: (ctx) => {
              const raw = ctx.raw;
              if (raw && raw.id) {
                return `${raw.id} (${raw.pname}): Disc ${raw.x}% → Margin ${raw.y.toFixed(1)}% (${fmtCurr(raw.sales)})`;
              }
              return `Trendline: ${ctx.parsed.y.toFixed(1)}%`;
            }
          }
        }
      },
      scales: {
        x: {
          title: { display: true, text: 'Discount Applied (%)', font: { size: 11, weight: '600' } },
          min: -1,
          max: 17,
          grid: { color: gridColor },
          ticks: { callback: (v) => v + '%' }
        },
        y: {
          title: { display: true, text: 'Profit Margin (%)', font: { size: 11, weight: '600' } },
          min: 0,
          max: 55,
          grid: { color: gridColor },
          ticks: { callback: (v) => v + '%' }
        }
      }
    }
  });

  // --- CHART 7: OPERATIONAL HEALTH MINI DONUTS ---
  renderMiniDonut('chartDonutStatus', 'status', ['Shipped', 'Completed', 'Pending'], ['#2563eb', '#16a34a', '#f59e0b']);
  renderMiniDonut('chartDonutPay', 'pay', ['Credit Card', 'UPI', 'Cash'], ['#0f4c81', '#0d9488', '#6366f1']);
  renderMiniDonut('chartDonutReturn', 'ret', ['No', 'Yes'], ['#16a34a', '#dc2626']);
}

function renderMiniDonut(canvasId, field, labelsOrder, colors) {
  const counts = labelsOrder.map(l => filteredData.filter(d => d[field] === l).length);
  const total = counts.reduce((a, b) => a + b, 0) || 1;
  if (charts[canvasId]) charts[canvasId].destroy();
  charts[canvasId] = new Chart(document.getElementById(canvasId), {
    type: 'doughnut',
    data: {
      labels: labelsOrder.map(l => field === 'ret' ? (l === 'Yes' ? 'Returned' : 'Retained') : l),
      datasets: [{
        data: counts,
        backgroundColor: colors,
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '58%',
      animation: { duration: 220 },
      plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 9, font: { size: 10.5 }, padding: 6 } },
        tooltip: {
          callbacks: {
            label: (ctx) => `${ctx.label}: ${ctx.parsed} orders (${((ctx.parsed / total) * 100).toFixed(1)}%)`
          }
        }
      }
    }
  });
}

// 3. DYNAMIC ACTIONABLE INSIGHTS GENERATOR
function updateInsights() {
  const n = filteredData.length;
  const container = document.getElementById('insightsContainer');
  if (n === 0) {
    container.innerHTML = `<div class="insight-card warn"><div class="insight-head">No Matching Records</div><div class="insight-body">Adjust or reset your active filters to view executive insights.</div></div>`;
    return;
  }

  // 1. YoY Growth & 2025 Partial Pace
  const s23 = filteredData.filter(d => d.yr === 2023).reduce((s, d) => s + d.sales, 0);
  const s24 = filteredData.filter(d => d.yr === 2024).reduce((s, d) => s + d.sales, 0);
  const s25 = filteredData.filter(d => d.yr === 2025).reduce((s, d) => s + d.sales, 0);
  const yoy24 = s23 > 0 ? ((s24 - s23) / s23 * 100).toFixed(1) : 'N/A';

  // 2. Return Rate Risk
  const retOrders = filteredData.filter(d => d.ret === 'Yes');
  const retRate = (retOrders.length / n * 100).toFixed(1);
  const retSalesExposure = retOrders.reduce((s, d) => s + d.sales, 0);

  // 3. Category & Brand Margin vs Revenue
  const catStats = {};
  filteredData.forEach(d => {
    if (!catStats[d.cat]) catStats[d.cat] = { s: 0, p: 0 };
    catStats[d.cat].s += d.sales;
    catStats[d.cat].p += d.profit;
  });
  const topRevCat = Object.keys(catStats).sort((a, b) => catStats[b].s - catStats[a].s)[0] || 'N/A';
  const topMargCat = Object.keys(catStats).sort((a, b) => (catStats[b].p / catStats[b].s) - (catStats[a].p / catStats[a].s))[0] || 'N/A';
  const topMargCatPct = catStats[topMargCat] ? (catStats[topMargCat].p / catStats[topMargCat].s * 100).toFixed(1) : '0.0';

  const brandStats = {};
  filteredData.forEach(d => {
    if (!brandStats[d.brand]) brandStats[d.brand] = { s: 0, p: 0 };
    brandStats[d.brand].s += d.sales;
    brandStats[d.brand].p += d.profit;
  });
  const topMargBrand = Object.keys(brandStats).sort((a, b) => (brandStats[b].p / brandStats[b].s) - (brandStats[a].p / brandStats[a].s))[0] || 'N/A';
  const topMargBrandPct = brandStats[topMargBrand] ? (brandStats[topMargBrand].p / brandStats[topMargBrand].s * 100).toFixed(1) : '0.0';

  // 4. Discount Margin Erosion
  const zeroDisc = filteredData.filter(d => d.disc === 0);
  const highDisc = filteredData.filter(d => d.disc >= 15);
  const mZero = zeroDisc.length ? (zeroDisc.reduce((s, d) => s + d.margin, 0) / zeroDisc.length).toFixed(1) : 'N/A';
  const mHigh = highDisc.length ? (highDisc.reduce((s, d) => s + d.margin, 0) / highDisc.length).toFixed(1) : 'N/A';
  const rVal = calcPearson(filteredData.map(d => d.disc), filteredData.map(d => d.margin)).toFixed(2);

  // 5. Regional Imbalance
  const regStats = {};
  filteredData.forEach(d => {
    if (!regStats[d.reg]) regStats[d.reg] = { s: 0, p: 0 };
    regStats[d.reg].s += d.sales;
    regStats[d.reg].p += d.profit;
  });
  const topRevReg = Object.keys(regStats).sort((a, b) => regStats[b].s - regStats[a].s)[0] || 'N/A';
  const topMargReg = Object.keys(regStats).sort((a, b) => (regStats[b].p / regStats[b].s) - (regStats[a].p / regStats[a].s))[0] || 'N/A';
  const topMargRegPct = regStats[topMargReg] ? (regStats[topMargReg].p / regStats[topMargReg].s * 100).toFixed(1) : '0.0';

  // 6. Rep Spread
  const repStats = {};
  filteredData.forEach(d => { repStats[d.rep] = (repStats[d.rep] || 0) + d.sales; });
  const sortedReps = Object.keys(repStats).sort((a, b) => repStats[b] - repStats[a]);
  const topRep = sortedReps[0] || 'N/A';
  const topRepSales = repStats[topRep] || 0;

  container.innerHTML = `
    <div class="insight-card amber">
      <div class="insight-head">
        <span>1. Growth Trajectory & 2025 YTD Pace</span>
        <span class="insight-badge" style="background:rgba(217,119,6,0.15);color:#d97706;">Pipeline Watch</span>
      </div>
      <div class="insight-body">
        Full-year 2024 revenue (<strong>${fmtCurrCompact(s24)}</strong>) grew <strong>+${yoy24}%</strong> over 2023 (<strong>${fmtCurrCompact(s23)}</strong>). Current 2025 YTD revenue is <strong>${fmtCurrCompact(s25)}</strong> (partial year through April only).
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Audit Q2–Q3 pipeline velocity and seasonal booking patterns before treating 2025 YTD figures as a structural slowdown.
      </div>
    </div>

    <div class="insight-card warn">
      <div class="insight-head">
        <span>2. Elevated Return Rate Exposure</span>
        <span class="insight-badge" style="background:rgba(220,38,38,0.15);color:#dc2626;">Critical Risk</span>
      </div>
      <div class="insight-body">
        Return rate in the current selection stands at <strong>${retRate}%</strong> (<strong>${retOrders.length}</strong> of ${n} orders), placing <strong>${fmtCurrCompact(retSalesExposure)}</strong> in gross revenue at risk of reversal.
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Launch an immediate root-cause audit across fulfillment packaging, SKU expectations, and transit damage with Logistics & QA.
      </div>
    </div>

    <div class="insight-card teal">
      <div class="insight-head">
        <span>3. Revenue Leader ≠ Margin Leader</span>
        <span class="insight-badge" style="background:rgba(13,148,136,0.15);color:#0d9488;">Mix Shift</span>
      </div>
      <div class="insight-body">
        <strong>${topRevCat}</strong> drives the highest revenue (${fmtCurrCompact(catStats[topRevCat]?.s || 0)}), but <strong>${topMargCat}</strong> yields the strongest margin (<strong>${topMargCatPct}%</strong>). By brand, <strong>${topMargBrand}</strong> leads profitability at <strong>${topMargBrandPct}%</strong>.
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Reallocate promotional spend and bundle incentives toward high-margin <strong>${topMargCat}</strong> and <strong>${topMargBrand}</strong> lines.
      </div>
    </div>

    <div class="insight-card purple">
      <div class="insight-head">
        <span>4. Discounting Erodes Profitability</span>
        <span class="insight-badge" style="background:rgba(124,58,237,0.15);color:#7c3aed;">r = ${rVal}</span>
      </div>
      <div class="insight-body">
        Discount % and Profit Margin % show a strong negative correlation (<strong>r = ${rVal}</strong>). Undiscounted orders average <strong>${mZero}%</strong> margin vs. <strong>${mHigh}%</strong> at 15% discount.
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Enforce deal-desk approval floors on ≥15% discounts and tie sales rep variable compensation to realized net margin, not gross revenue alone.
      </div>
    </div>

    <div class="insight-card success">
      <div class="insight-head">
        <span>5. Regional Expansion Opportunity</span>
        <span class="insight-badge" style="background:rgba(22,163,74,0.15);color:#16a34a;">Geo Upside</span>
      </div>
      <div class="insight-body">
        <strong>${topRevReg}</strong> leads total revenue (<strong>${fmtCurrCompact(regStats[topRevReg]?.s || 0)}</strong>), whereas <strong>${topMargReg}</strong> achieves the highest unit profitability (<strong>${topMargRegPct}%</strong> margin) on lower order volume.
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Test targeted customer-acquisition campaigns in <strong>${topMargReg}</strong> to scale volume while preserving its superior margin profile.
      </div>
    </div>

    <div class="insight-card">
      <div class="insight-head">
        <span>6. Sales Rep Performance Dispersion</span>
        <span class="insight-badge" style="background:rgba(37,99,235,0.15);color:#2563eb;">Sales Enablement</span>
      </div>
      <div class="insight-body">
        Top performer <strong>${topRep}</strong> generated <strong>${fmtCurrCompact(topRepSales)}</strong> across ${sortedReps.length} active reps, outpacing the long tail of lower-volume representatives.
      </div>
      <div class="insight-action">
        🎯 <strong>Leadership Action:</strong> Pair top-quartile reps (${topRep}) with bottom-quartile reps for playbook standardization on account sizing and discount discipline.
      </div>
    </div>
  `;
}

// 4. COLLAPSIBLE TABLE & EXPORT
function toggleTable() {
  const wrap = document.getElementById('tableCollapseWrap');
  const btn = document.getElementById('btnToggleTable');
  const isHidden = wrap.style.display === 'none';
  wrap.style.display = isHidden ? 'block' : 'none';
  btn.textContent = isHidden ? 'Hide Order Details ▴' : 'Show Order Details ▾';

}

function renderTable() {
  const wrap = document.getElementById('tableCollapseWrap');
  if (wrap.style.display === 'none') return;
  const q = (document.getElementById('tableSearch').value || '').toLowerCase();
  const rows = filteredData.filter(d =>
    !q ||
    d.id.toLowerCase().includes(q) ||
    d.cname.toLowerCase().includes(q) ||
    d.pname.toLowerCase().includes(q) ||
    d.city.toLowerCase().includes(q) ||
    d.rep.toLowerCase().includes(q)
  );
  const slice = rows.slice(0, 100);
  document.getElementById('tableCountNote').textContent = `Displaying ${slice.length} of ${rows.length} matching records`;

  document.getElementById('tableBody').innerHTML = slice.map(d => `
    <tr>
      <td><strong>${d.id}</strong></td>
      <td>${d.dt}</td>
      <td>${d.cname} <span style="color:var(--text-muted);font-size:11px;">(${d.cid})</span></td>
      <td>${d.cat}</td>
      <td>${d.pname}</td>
      <td>${d.brand}</td>
      <td>${d.reg} • ${d.city}</td>
      <td>${d.rep}</td>
      <td>${d.qty}</td>
      <td>${d.disc}%</td>
      <td><strong>${fmtCurr(d.sales)}</strong></td>
      <td style="color:var(--accent-teal);font-weight:600;">${fmtCurr(d.profit)}</td>
      <td>${d.margin.toFixed(1)}%</td>
      <td>${d.status}</td>

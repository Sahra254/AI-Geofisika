      labels: regNames,
      datasets: [
        {
          type: 'line',
          label: 'Margin %',
          data: regMargin,
          borderColor: '#dc2626',
          backgroundColor: '#dc2626',
          borderWidth: 2,
          pointRadius: 4,
          yAxisID: 'y1'
        },
        {
          type: 'bar',
          label: 'Sales ($)',
          data: regSales,
          backgroundColor: '#2563eb',
          borderRadius: 4,
          yAxisID: 'y'
        },
        {
          type: 'bar',
          label: 'Profit ($)',
          data: regProfit,
          backgroundColor: '#0d9488',
          borderRadius: 4,
          yAxisID: 'y'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 220 },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'top', labels: { boxWidth: 10, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: (ctx) => ctx.dataset.yAxisID === 'y1'
              ? `Margin: ${ctx.parsed.y.toFixed(1)}%`
              : `${ctx.dataset.label}: ${fmtCurr(ctx.parsed.y)}`
          }
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, grid: { color: gridColor }, ticks: { callback: (v) => fmtCurrCompact(v) } },
        y1: { beginAtZero: true, max: 45, position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: (v) => v + '%' } }
      }
    }
  });

  // --- CHART 4: BRAND COMPARISON ---
  const brandMap = {};
  filteredData.forEach(d => {
    if (!brandMap[d.brand]) brandMap[d.brand] = { sales: 0, profit: 0 };
    brandMap[d.brand].sales += d.sales;
    brandMap[d.brand].profit += d.profit;
  });
  const brandNames = Object.keys(brandMap).sort((a, b) => brandMap[b].sales - brandMap[a].sales);
  const brandSales = brandNames.map(b => Math.round(brandMap[b].sales));
  const brandProfit = brandNames.map(b => Math.round(brandMap[b].profit));
  const brandMargins = brandNames.map(b => brandMap[b].sales > 0 ? +(brandMap[b].profit / brandMap[b].sales * 100).toFixed(1) : 0);

  if (charts.brand) charts.brand.destroy();
  charts.brand = new Chart(document.getElementById('chartBrand'), {
    type: 'bar',
    data: {
      labels: brandNames,
      datasets: [
        {
          type: 'line',
          label: 'Profit Margin %',
          data: brandMargins,
          borderColor: '#7c3aed',
          backgroundColor: '#7c3aed',
          borderWidth: 2.5,
          pointRadius: 5,
          yAxisID: 'y1'
        },
        {
          type: 'bar',
          label: 'Sales ($)',
          data: brandSales,
          backgroundColor: '#0f4c81',
          borderRadius: 4,
          yAxisID: 'y'
        },
        {
          type: 'bar',
          label: 'Profit ($)',
          data: brandProfit,
          backgroundColor: '#14b8a6',
          borderRadius: 4,
          yAxisID: 'y'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 220 },
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'top', labels: { boxWidth: 10, font: { size: 11 } } },
        tooltip: {
          callbacks: {
            label: (ctx) => ctx.dataset.yAxisID === 'y1'
              ? `Margin: ${ctx.parsed.y.toFixed(1)}%`
              : `${ctx.dataset.label}: ${fmtCurr(ctx.parsed.y)}`
          }
        }
      },
      scales: {
        x: { grid: { display: false } },
        y: { beginAtZero: true, grid: { color: gridColor }, ticks: { callback: (v) => fmtCurrCompact(v) } },
        y1: { beginAtZero: true, max: 45, position: 'right', grid: { drawOnChartArea: false }, ticks: { callback: (v) => v + '%' } }
      }
    }
  });

  // --- CHART 5: TOP 10 REPS OR TOP 10 PRODUCTS (HORIZONTAL BAR) ---
  const rankKey = rankMode === 'rep' ? 'rep' : 'pname';
  const rankMap = {};
  filteredData.forEach(d => {
    const k = d[rankKey];
    if (!rankMap[k]) rankMap[k] = { sales: 0, profit: 0 };
    rankMap[k].sales += d.sales;
    rankMap[k].profit += d.profit;
  });
  const top10Names = Object.keys(rankMap).sort((a, b) => rankMap[b].sales - rankMap[a].sales).slice(0, 10);
  const top10Sales = top10Names.map(k => Math.round(rankMap[k].sales));
  const top10Profit = top10Names.map(k => Math.round(rankMap[k].profit));

  if (charts.topRank) charts.topRank.destroy();
  charts.topRank = new Chart(document.getElementById('chartTopRank'), {
    type: 'bar',
    data: {
      labels: top10Names,
      datasets: [

function exportFilteredCSV() {
  const headers = ['Order ID','Order Date','Year','Quarter','Month-Year','Customer ID','Customer Name','Category','Sub Category','Product Name','Brand','Region','State','City','Sales Person','Quantity','Unit Price','Discount %','Cost Price','Sales','Profit','Profit Margin %','Order Status','Payment Mode','Ship Mode','Return Status'];
  const keys = ['id','dt','yr','qtr','my','cid','cname','cat','sub','pname','brand','reg','st','city','rep','qty','up','disc','cp','sales','profit','margin','status','pay','ship','ret'];
  const csvRows = [headers.join(',')];
  filteredData.forEach(d => {
    csvRows.push(keys.map(k => `"${String(d[k]).replace(/"/g, '""')}"`).join(','));
  });
  const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `Filtered_Sales_Profit_${filteredData.length}_Orders.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

// Boot
window.addEventListener('DOMContentLoaded', () => {
  initFilters();
  applyFilters();
});
</script>
</body>
</html>
